DATABASE_URL=sqlite:///./data/pharmatrace.db
ADMIN_EMAIL=admin@thermatrace.local
ADMIN_PASSWORD=PharmaDemo!2026
FRONTEND_ORIGINS=http://localhost:3100,http://127.0.0.1:3100
SIMULATION_INTERVAL=3
COOKIE_SECURE=false
OSRM_BASE_URL=https://router.project-osrm.org

# Optional production database: postgresql+psycopg://user:password@host:5432/thermatrace
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/thermatrace

# Optional real-sensor MQTT adapter. Keep disabled for the software simulation.
MQTT_ENABLED=false
MQTT_BROKER_HOST=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=thermatrace/vehicles/+/telemetry
MQTT_TLS=true

# Optional alert email transport. Secrets belong only in backend/.env.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@thermatrace.local
SMTP_STARTTLS=true
MODEL_BUNDLE_PATH=data/models/validated-risk-model.joblib

# Free local voice intelligence. Ollama serves only on this computer.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
VOICE_WHISPER_MODEL=small
VOICE_WHISPER_DEVICE=cpu
VOICE_WHISPER_COMPUTE_TYPE=int8
VOICE_MODEL_DIR=data/voices
VOICE_HINDI_MODEL=hi_IN-pratham-medium
VOICE_ENGLISH_MODEL=en_US-lessac-medium
VOICE_STORE_AUDIO=false
