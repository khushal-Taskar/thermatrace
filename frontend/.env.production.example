# Render backend URL used by the Next.js same-origin API proxy.
BACKEND_URL=https://thermatrace-api.onrender.com

# Browser WebSocket endpoint. Use wss:// in production.
NEXT_PUBLIC_WS_URL=wss://thermatrace-api.onrender.com/ws/telemetry

# Public demo credential displayed on the login page. Keep it synchronized
# with the backend ADMIN_PASSWORD for a demonstration-only deployment.
NEXT_PUBLIC_DEMO_PASSWORD=replace-with-the-demo-password
